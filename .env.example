# Copy to .env and adjust. .env is gitignored — never commit real values.

# RPC endpoint.
#   devnet has the ZK ElGamal Proof program + updated Token-2022 enabled,
#   so the full confidential-transfer lifecycle works without a local validator.
RPC_URL=https://api.devnet.solana.com
# Alternative — local validator (must clone Token-2022 + ZK programs):
# RPC_URL=http://127.0.0.1:8899

# Path to your Solana keypair JSON (gitignored).
# Created by ./scripts/create-wallet.sh
WALLET_KEYPAIR_PATH=./keys/wallet.json
